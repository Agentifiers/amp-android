name: SGR attributes and colors combine in one sequence
source: xterm ctlseqs (Patch #411) https://invisible-island.net/xterm/ctlseqs/ctlseqs.txt:1189-1324 CSI Pm m (SGR)
size: 80x24
input: \e[0;1;4;38;5;100;48;2;1;2;3mQ
row 0: |Q|
cell 0,0: char=Q bold underline fg=100 bg=#010203
