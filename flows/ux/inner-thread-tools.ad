context platform=android timeout=180000
open com.agentifiers.amp --relaunch
trigger-app-event use-server {"scenario":"thread-tools"}
trigger-app-event sign-in-token {"token":"fake-amp-accepts-any-bearer"}
trigger-app-event geometry-override {"widthDp":1080,"creasesDp":[335,717]}
wait id=thread-list 30000
trigger-app-event open-thread {"threadId":"T-0a0b0c0d-0000-7000-8000-000000000002"}
trigger-app-event set-arrangement {"name":"Triage"}
wait id=step-TU-ToolsGallery0000000001 30000
wait 1500
screenshot ${UX_OUT}/thread-tools-collapsed.png
press id=step-TU-ToolsGallery0000000001
wait id=tool-card-TU-ToolsGallery0000000013-toggle 10000
wait 1500
screenshot ${UX_OUT}/thread-tools-expanded.png
press id=tool-card-TU-ToolsGallery0000000013-toggle
wait 1000
wait 1500
screenshot ${UX_OUT}/thread-tools-error-card.png
trigger-app-event geometry-override {}
close
