context platform=android timeout=180000
open com.agentifiers.amp --relaunch
trigger-app-event use-server {"scenario":"puck-chat"}
trigger-app-event sign-in-token {"token":"fake-amp-accepts-any-bearer"}
trigger-app-event geometry-override {"widthDp":1080,"creasesDp":[335,717]}
trigger-app-event set-arrangement {"name":"Triage"}
wait id=pane-sidebar 30000
click id=nav-puck
wait id=puck-input 30000
wait 1500
screenshot ${UX_OUT}/puck-pane.png
fill id=puck-input "Start a thread to fix the rail"
click id=puck-send
wait text "I can start an agent for that. Which project?" 30000
wait 1500
screenshot ${UX_OUT}/puck-reply.png
click id=puck-switcher
wait id=puck-conversation-T-f1ee7000-0000-4000-8000-000000000038 10000
wait 1500
screenshot ${UX_OUT}/puck-switcher.png
back
trigger-app-event geometry-override {}
close
