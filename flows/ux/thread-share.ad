context platform=android timeout=180000
open com.agentifiers.amp --relaunch
trigger-app-event use-server {"scenario":"thread-blocks"}
trigger-app-event sign-in-token {"token":"fake-amp-accepts-any-bearer"}
trigger-app-event geometry-override {"widthDp":1080,"creasesDp":[335,717]}
wait id=thread-list 30000
trigger-app-event open-thread {"threadId":"T-0a0b0c0d-0000-7000-8000-000000000003"}
trigger-app-event set-arrangement {"name":"Triage"}
wait id=transcript-recap 30000
click id=thread-share
wait id=share-sheet 10000
swipe 1080 1400 1080 300
wait id=share-create-workspace 10000
wait 1500
screenshot ${UX_OUT}/thread-share-sheet.png
trigger-app-event geometry-override {}
close
