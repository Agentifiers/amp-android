context platform=android timeout=180000
open com.agentifiers.amp --relaunch
trigger-app-event use-server {"scenario":"changes"}
trigger-app-event sign-in-token {"token":"fake-amp-accepts-any-bearer"}
trigger-app-event geometry-override {"widthDp":1080,"creasesDp":[335,717]}
wait id=thread-list 30000
trigger-app-event open-thread {"threadId":"T-01a16702-3202-73fb-8f52-e4498ccd3721","pane":"changes"}
trigger-app-event set-arrangement {"name":"Triage"}
wait 2500
wait 1500
screenshot ${UX_OUT}/arrangement-triage.png
trigger-app-event set-arrangement {"name":"Review"}
wait 2500
wait 1500
screenshot ${UX_OUT}/arrangement-review.png
trigger-app-event set-arrangement {"name":"Terminal"}
wait 2500
wait 1500
screenshot ${UX_OUT}/arrangement-terminal.png
trigger-app-event set-arrangement {"name":"Read"}
wait 2500
wait 1500
screenshot ${UX_OUT}/arrangement-read.png
trigger-app-event set-arrangement {"name":"Puck"}
wait 2500
wait 1500
screenshot ${UX_OUT}/arrangement-puck.png
trigger-app-event set-arrangement {"name":"Focus"}
wait 2500
wait 1500
screenshot ${UX_OUT}/arrangement-focus.png
trigger-app-event set-arrangement {"name":"Triage"}
trigger-app-event geometry-override {}
close
