context platform=android timeout=120000
open com.agentifiers.amp --relaunch
trigger-app-event use-server {"scenario":"plugin-dialog"}
trigger-app-event sign-in-token {"token":"fake-amp-accepts-any-bearer"}
wait id=pane-sidebar 30000
trigger-app-event open-thread {"threadId":"T-01a16738-2ec2-7354-98e9-688bc413f079"}
wait id=agent-status 30000
wait 3000
screenshot ${AD_ARTIFACTS:-build/flows}/gate-plugin-dialog-0-thread.png
trigger-app-event run-plugin-command {"threadId":"T-01a16738-2ec2-7354-98e9-688bc413f079","plugin":"spike-dialog","commandId":"spike-dialog"}
wait id=gate-dock 30000
wait id=gate-submit 30000
screenshot ${AD_ARTIFACTS:-build/flows}/gate-plugin-dialog-1-confirm.png
click id=gate-submit
wait id=gate-field-value 30000
fill id=gate-field-value "hello from android"
screenshot ${AD_ARTIFACTS:-build/flows}/gate-plugin-dialog-2-input.png
click id=gate-submit
wait id=gate-notice 30000
wait text "spike-dialog confirmed=true text=hello from android" 10000
find id gate-record- exists
screenshot ${AD_ARTIFACTS:-build/flows}/gate-plugin-dialog-3-settled.png
close
