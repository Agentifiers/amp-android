context platform=android timeout=120000
open com.agentifiers.amp --relaunch
trigger-app-event use-server {"scenario":"gate-plugins"}
trigger-app-event sign-in-token {"token":"fake-amp-accepts-any-bearer"}
wait id=pane-sidebar 30000
trigger-app-event open-thread {"threadId":"T-01a16738-2ec2-7354-98e9-688bc413f079"}
wait id=agent-status 30000
wait 3000
trigger-app-event run-plugin-command {"threadId":"T-01a16738-2ec2-7354-98e9-688bc413f079","plugin":"deploy","commandId":"deploy-key"}
wait id=gate-field-value 30000
fill id=gate-field-value "fake-deploy-key-1234"
screenshot ${AD_ARTIFACTS:-build/flows}/gate-secret-1-masked.png
click id=gate-submit
wait text "deploy-key received 20 characters" 30000
close
