context platform=android timeout=120000
open com.agentifiers.amp --relaunch
trigger-app-event use-server {"scenario":"files"}
trigger-app-event sign-in-token {"token":"fake-amp-accepts-any-bearer"}
wait id=thread-list 30000
trigger-app-event open-thread {"threadId":"T-01a16738-2ec2-7354-98e9-688bc413f079","pane":"changes"}
wait id=pane-changes 30000
wait id=changes-error 30000
is absent id=changes-error-details-text
click id=changes-error-details
wait id=changes-error-details-text 10000
find text "fake-amp has no recording of client_git_command with these params" exists
wait id=changes-refresh 10000
screenshot ${AD_ARTIFACTS:-build/flows}/changes-error-details.png
click id=changes-error-details
wait absent id=changes-error-details-text 10000
close
