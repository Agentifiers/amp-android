context platform=android timeout=180000
open com.agentifiers.amp --relaunch
trigger-app-event use-server {"scenario":"newthread-self-hosted"}
trigger-app-event sign-in-token {"token":"fake-amp-accepts-any-bearer"}
trigger-app-event set-arrangement {"name":"Triage"}
wait id=sidebar-empty 30000
click id=sidebar-empty-new-thread
wait id=new-thread-composer 15000
click id=composer-executor
wait id=executor-picker 10000
click id=executor-orb
wait id=orb-provider-add 10000
click id=orb-provider-add
fill id=orb-provider-name "example-orbs-1"
click id=orb-provider-save
wait id=orb-provider-self-hosted-example-orbs-1 10000
click id=orb-provider-add
fill id=orb-provider-name "example-orbs-2"
keyboard enter
wait id=orb-provider-self-hosted-example-orbs-2 10000
click id=orb-project-none
click id=orb-size-a1-small
click id=orb-provider-self-hosted-example-orbs-2
scroll down 0.5 --until id=orb-use
screenshot ${AD_ARTIFACTS:-build/flows}/newthread-self-hosted-picker.png
click id=orb-use
wait absent id=executor-picker 10000
wait text "Executor: Orb · example-orbs-2 · a1.small" 10000
fill id=composer-input "Print uname -a on the second provider"
click id=composer-send
wait id=pane-thread 30000
wait text "Print uname -a on the second provider" 30000
is absent id=new-thread-notice
screenshot ${AD_ARTIFACTS:-build/flows}/newthread-self-hosted-landed.png
click id=new-thread
wait id=new-thread-composer 15000
click id=composer-executor
wait id=executor-picker 10000
click id=executor-orb
scroll down 0.5 --until id=orb-provider-self-hosted-example-orbs-2
wait text "Last used" 10000
screenshot ${AD_ARTIFACTS:-build/flows}/newthread-self-hosted-remembered.png
close
